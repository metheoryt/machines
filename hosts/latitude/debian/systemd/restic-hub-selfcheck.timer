[Unit]
Description=Verify the restic REST backup hub after boot and daily

[Timer]
# 15 min after boot: every failure this has ever had was a bind race at
# container start, so the boot run is the one that matters most. 15 min lets
# docker, the USB enumeration and the nofail mount all settle first.
OnBootSec=15min
# 09:00 daily, comfortably after the desktop-wsl client's 06:00 backup, so the
# freshness check reads that morning's snapshot rather than yesterday's.
OnCalendar=*-*-* 09:00:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
